# Base URL of the running GitScout FastAPI backend (include the /api/v1 prefix).
# Local dev:  http://localhost:8000/api/v1
# Production: https://<your-deployment>/api/v1
GITSCOUT_API_BASE=http://localhost:8000/api/v1

# Where this MCP server listens (Streamable HTTP endpoint = http://MCP_HOST:MCP_PORT/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=9000

# Per-request timeout in seconds (triage can invoke an LLM, so keep this generous).
GITSCOUT_TIMEOUT=60
